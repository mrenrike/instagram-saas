# ============================================================================
# Instagram Analytics SaaS — variáveis de ambiente
#
# Item 1 — Nenhum valor real entra neste arquivo. Ele é versionado apenas como
# documentação da forma esperada de cada variável. Os valores reais ficam no painel
# do Railway (ou num .env local, que é gitignored).
#
# Gere segredos com:  openssl rand -base64 32
# Nunca reutilize o mesmo segredo entre projetos ou entre staging e produção.
# ============================================================================

# ---- Ambiente --------------------------------------------------------------
# production | staging | development | test
# Em production o app exige ALLOWED_ORIGINS, força HTTPS e não publica /docs.
ENVIRONMENT=production

# ---- Sessão ----------------------------------------------------------------
# 32 bytes em base64. A chave de assinatura dos tokens de acesso é derivada desta.
SESSION_ENCRYPTION_KEY=
SESSIONS_DIR=./sessions
SESSION_TTL_HOURS=24

# ---- Transporte (itens 18, 19) ---------------------------------------------
# Lista separada por vírgula. "*" é recusado em produção.
ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br
FRONTEND_BASE_URL=https://seudominio.com.br
FORCE_HTTPS=true
# true apenas quando o app roda atrás de um proxy que sobrescreve X-Forwarded-For
# (Railway, Nginx, Cloudflare). Com false o rate limit usa o IP do socket.
TRUST_PROXY=true
HSTS_MAX_AGE=63072000
MAX_BODY_BYTES=262144

# ---- Rate limiting (item 11) -----------------------------------------------
RATE_LIMIT_ENABLED=true

# ---- Proteção contra bots (item 12) ----------------------------------------
# Opcional. Sem isso valem apenas o rate limit e o honeypot.
# Chave secreta do Cloudflare Turnstile (a sitekey pública vai no frontend).
TURNSTILE_SECRET=
CAPTCHA_PROVIDER=turnstile

# ---- Preço -----------------------------------------------------------------
REPORT_PRICE_BRL=6700

# ---- OpenPix ---------------------------------------------------------------
OPENPIX_APP_ID=
OPENPIX_WEBHOOK_SECRET=

# ---- Meta OAuth ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://sua-api.railway.app/oauth/callback

# ---- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Resend ----------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=relatorios@seudominio.com.br

# ---- Admin (itens 6, 10) ---------------------------------------------------
ADMIN_EMAIL=
# Preferido: hash pbkdf2 gerado por `python -m backend.tools.hash_secret`.
# O segredo em claro nunca precisa ficar guardado no servidor.
ADMIN_SECRET_HASH=
# Alternativa (mínimo 32 caracteres aleatórios). Use um OU outro.
ADMIN_SECRET=

# ---- Google Sheets CRM -----------------------------------------------------
# Use uma service account com acesso APENAS a esta planilha (menor privilégio).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Cupons ----------------------------------------------------------------
COUPONS_FILE=./coupons.json

# ---- Upsell da agência -----------------------------------------------------
AGENCY_NAME=
AGENCY_LINK=https://suaagencia.com.br/diagnostico
AGENCY_HANDLE=@suaagencia
AGENCY_EMAIL=contato@suaagencia.com.br
